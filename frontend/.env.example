# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AI Microservice Base URL
VITE_AI_SERVICE_URL=http://127.0.0.1:8000

# Server-side AI calls use ai-service's HF_API_TOKEN (never commit a VITE_ token —
# Vite inlines VITE_* into the public JS bundle). Operators may paste a token
# at runtime in AI Workbench; it is stored in browser localStorage only.

# Optional: CARTO Basemaps API key (free at https://carto.com/basemaps/apikey)
# VITE_CARTO_API_KEY=
