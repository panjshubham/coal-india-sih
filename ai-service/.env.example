# Khanan-Net AI Service — Environment Variables Template
# Get your free token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_api_token_here
HF_NAMESPACE=your_hf_username

# Optional: Supabase credentials (if writing violations directly from AI service)
# NOTE: the service accepts BOTH names, but prefer SUPABASE_SERVICE_ROLE_KEY
# (this is the documented name). SUPABASE_KEY is a legacy fallback.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# CORS: comma-separated list of allowed frontend origins (no wildcard).
# e.g. ALLOWED_ORIGINS=https://coalguard.vercel.app,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Cloud model storage credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HF_S3_ENDPOINT_URL=https://hub-ci.huggingface.co/s3
